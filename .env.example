# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Optional: model for all agents (leave empty to use the Agents SDK default)
OPENAI_MODEL=gpt-6.1-sol
# Optional but recommended: free key from https://openalex.org/settings/api (raises daily quota)
OPENALEX_API_KEY=
OPENALEX_EMAIL=
# Optional: https://www.semanticscholar.org/product/api#api-key-form (without it, requests are often rate-limited)
SEMANTIC_SCHOLAR_API_KEY=
# Required by SEC for EDGAR access: "Name contact-email"
SEC_USER_AGENT=
